{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks",
            "commandWindows": "git config core.hooksPath .githooks",
            "timeout": 30,
            "statusMessage": "Git のルール確認（.githooks）を有効にしています"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.githooks/ai-guard.sh\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path (git rev-parse --show-toplevel) '.githooks/ai-guard.ps1'); exit $LASTEXITCODE\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
